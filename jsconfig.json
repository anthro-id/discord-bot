{
  "compilerOptions": {
    "strict": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "allowJs": true,
    "checkJs": true,
    "strictNullChecks": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },

  "include": [
    "src"
  ],

  "exclude": [
    "node_modules"
  ]
}